# Static V3 Cloud Run preview. Cloud Build validates and prepares landing/dist first.
# No legal source files, API keys or secret variables are copied into the runtime image.
FROM nginx:1.27-alpine
COPY landing/nginx.cloudrun.conf /etc/nginx/conf.d/default.conf
COPY landing/dist/ /usr/share/nginx/html/
RUN nginx -t
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
