# Static Protolume v3 preview, served by the existing Cloud Run frontend service.
# Intentional: preview-only image (noindex, mailto fallback, draft privacy page).
FROM node:22.22.3-bookworm-slim AS build
WORKDIR /app
COPY landing/ ./landing/
COPY frontend/scripts/validate-public-legal-config.cjs ./frontend/scripts/validate-public-legal-config.cjs
COPY frontend/src/assets/protolume-logo-horizontal-dark.svg ./frontend/src/assets/
COPY frontend/src/assets/favicon.svg ./frontend/src/assets/
RUN node landing/build.mjs --preview && node landing/verify-dist.mjs --preview

FROM nginx:1.27-alpine
COPY landing/nginx.cloudrun.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/landing/dist/ /usr/share/nginx/html/
RUN nginx -t
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
