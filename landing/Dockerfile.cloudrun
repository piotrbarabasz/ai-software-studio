# Static Protolume V3 Cloud Run runtime. Cloud Build validates landing/dist first.
# No legal source files, API keys or secret variables are copied into the runtime image.
FROM nginx:1.27-alpine
ARG NGINX_CONFIG=landing/nginx.cloudrun.conf
COPY ${NGINX_CONFIG} /etc/nginx/conf.d/default.conf
COPY landing/dist/ /usr/share/nginx/html/
RUN nginx -t
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
