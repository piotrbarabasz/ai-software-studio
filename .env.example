# Copy this file to .env (already gitignored).
# Public IDs and non-secret settings only. NEVER store credentials, tokens or legal JSON here.
GCP_PROJECT_ID=ai-software-studio-501918
GCP_ACCOUNT=kontakt@protolume.pl
GCP_REGION=europe-central2
# Cloud Run traffic tag: preview URL with 0% of public domain traffic.
CLOUD_RUN_PREVIEW_TAG=v3-review

# Optional public Formspree ID for direct-mail Cloud Run preview (requires approved legal config in GCP Secret Manager).
# Keep blank until the recipient kontakt@protolume.pl is verified. Also required for local production build.
FORM_ENDPOINT=

# Optional: path to APPROVED legal JSON for a local production build check only.
# In Cloud Build, legal data comes from Secret Manager instead.
PUBLIC_LEGAL_CONFIG_PATH=
